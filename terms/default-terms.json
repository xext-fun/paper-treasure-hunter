{
  "version": 1,
  "groups": [
    {
      "name": "Dates, times and durations",
      "terms": [
        { "label": "Dates", "pattern": "\\b(?:0?[1-9]|1[0-2])[/-](?:0?[1-9]|[12]\\d|3[01])[/-](?:19|20)?\\d{2}\\b|\\b(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?\\s+\\d{1,2}(?:,?\\s+\\d{4})?\\b" },
        { "label": "Times", "pattern": "\\b(?:1[0-2]|0?[1-9])(?::[0-5]\\d)?\\s*(?:a\\.?m\\.?|p\\.?m\\.?)\\b|\\b(?:[01]?\\d|2[0-3]):[0-5]\\d(?:\\s*(?:UTC|GMT))?\\b" },
        { "label": "Durations", "pattern": "\\b\\d+(?:\\.\\d+)?\\s*(?:business\\s+)?(?:second|minute|hour|day|week|month|year)s?\\b|\\b(?:one|two|three|four|five|six|seven|eight|nine|ten|thirty|sixty|ninety)\\s+(?:business\\s+)?(?:day|week|month|year)s?\\b" }
      ]
    },
    {
      "name": "Legal terms",
      "terms": [
        { "label": "Termination", "pattern": "\\bterminat(?:e|es|ed|ing|ion|ions|able)\\b" },
        { "label": "Intellectual property", "pattern": "\\bintellectual\\s+propert(?:y|ies)\\b|\\bI\\.?P\\.?\\s+rights?\\b" },
        { "label": "Arbitration", "pattern": "\\barbitrat(?:e|es|ed|ing|ion|ions|or|ors)\\b" },
        { "label": "Confidentiality", "pattern": "\\bconfidential(?:ity|ly)?\\b|\\bnon[-\\s]?disclosur(?:e|es)\\b" },
        { "label": "Indemnification", "pattern": "\\bindemnif(?:y|ies|ied|ication|ications)\\b|\\bindemnit(?:y|ies)\\b" },
        { "label": "Liability", "pattern": "\\bliabilit(?:y|ies)\\b|\\bliable\\b" },
        { "label": "Breach", "pattern": "\\bbreach(?:es|ed|ing)?\\b" },
        { "label": "Damages", "pattern": "\\bdamag(?:e|es|ed|ing)\\b" },
        { "label": "Governing law", "pattern": "\\bgoverning\\s+law\\b|\\bchoice\\s+of\\s+law\\b" }
      ]
    }
  ]
}
